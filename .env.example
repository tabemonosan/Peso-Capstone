# Copy this file to .env and fill in your values.
# Not needed when running with `docker compose up` (MongoDB is bundled).

# Option A: local MongoDB
MONGODB_URI=mongodb://localhost:27017/peso-capstone

# Option B: MongoDB Atlas
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/peso-capstone

# WARNING: development only. When SMTP is not configured, setting this to true
# logs full email-verification links (which contain account tokens) to the
# server console so you can verify accounts by hand. Anyone with access to the
# logs could use those links. It is ignored when NODE_ENV=production and should
# never be enabled on a shared or deployed machine.
# DEV_LOG_VERIFICATION_LINKS=false
