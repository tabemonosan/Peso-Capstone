# Copy this file to .env and fill in your values.
# Not needed when running with `docker compose up` (MongoDB is bundled).

# Option A: local MongoDB
MONGODB_URI=mongodb://localhost:27017/peso-capstone

# Option B: MongoDB Atlas
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/peso-capstone

# ---- Email ----
# Mode A: real SMTP. Used when SMTP_HOST, SMTP_USER and SMTP_PASS are set.
# Example below is for Gmail. WARNING: for Gmail you MUST generate an
# "App Password" (Google Account > Security > 2-Step Verification > App
# passwords) — never put your real account password here.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587            # 587 = STARTTLS, 465 = SSL
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM=               # optional; defaults to SMTP_USER

# Mode B (development only): temporary Ethereal inbox, no account setup.
# Emails are not really delivered; a preview URL is printed to the console.
# Ignored when NODE_ENV=production or when SMTP_* is set.


# Base URL used to build links inside emails (e.g. verification links).
# APP_URL=http://localhost:5173

# WARNING: development only. When SMTP is not configured, setting this to true
# logs full email-verification links (which contain account tokens) to the
# server console so you can verify accounts by hand. Anyone with access to the
# logs could use those links. It is ignored when NODE_ENV=production and should
# never be enabled on a shared or deployed machine.
# DEV_LOG_VERIFICATION_LINKS=false
